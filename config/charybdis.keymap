#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    unicode {
        compatible = "zmk,unicode";
        #address-cells = <1>;
        #size-cells = <0>;

        en_dash: en_dash {
            unicode = <0x2013>; /* – */
        };

        laquo: laquo {
            unicode = <0x00AB>; /* « */
        };

        raquo: raquo {
            unicode = <0x00BB>; /* » */
        };
    };

    combos {
        compatible = "zmk,combos";

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <17 18>;
            layers = <0>;
        };

        combo_left_click {
            bindings = <&mkp LCLK>;
            key-positions = <31 32>;
        };

        combo_middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <32 33>;
        };

        combo_right_click {
            bindings = <&mkp RCLK>;
            key-positions = <34 33>;
        };

        scroll {
            bindings = <&tog 5>;
            key-positions = <31 33>;
        };

        snipe {
            bindings = <&tog 6>;
            key-positions = <34 32>;
        };

        num_en {
            bindings = <&tog 2>;
            key-positions = <39 40>;
            layers = <0 2>;
        };

        num_ru {
            bindings = <&tog 3>;
            key-positions = <39 40>;
            layers = <1 3>;
        };

        combo_caps {
            bindings = <&kp CAPS>;
            key-positions = <13 14>;
        };

        to_en_layer_combo {
            bindings = <&to 0>;
            key-positions = <0 11>;
            layers = <1>;
        };

        to_ru_layer_combo {
            bindings = <&to 1>;
            key-positions = <0 11>;
            layers = <0>;
        };
    };

    macros {
        triple_grave: triple_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE>;
            label = "TRIPLE_GRAVE";
        };

        code_block: code_block {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE &kp ENTER &kp ENTER &kp GRAVE &kp GRAVE &kp GRAVE &kp LEFT &kp LEFT &kp LEFT &kp LEFT>;
            label = "CODE_BLOCK";
        };

        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "TO_RU";
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "TO_EN";
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
        };

        to_en_layer: to_en_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_press>,
                <&kp SPACE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LEFT_GUI &to 0>,
                <&macro_press>;

            label = "TO_EN_LAYER";
        };

        to_ru_layer: to_ru_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_press>,
                <&kp SPACE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LGUI &to 1>;

            label = "TO_RU_LAYER";
        };

        old: old {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp LEFT_ALT &to 0>;

            label = "OLD";
        };
    };

    behaviors {
        alt_to_caps: alt_to_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "ALT_TO_CAPS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&caps_word>;
        };

        myagkiy_tverdiy: myagkiy_tverdiy {
            compatible = "zmk,behavior-tap-dance";
            label = "MYAGKIY_TVERDIY";
            #binding-cells = <0>;
            bindings = <&kp RU_CYRILLIC_SOFT_SIGN>, <&kp RU_CYRILLIC_HARD_SIGN>;
        };

        sha_scha: sha_scha {
            compatible = "zmk,behavior-tap-dance";
            label = "SHA_SCHA";
            #binding-cells = <0>;
            bindings = <&kp RU_CYRILLIC_SHA>, <&kp RU_CYRILLIC_SHCHA>;
        };

        ye_yo: ye_yo {
            compatible = "zmk,behavior-tap-dance";
            label = "YE_YO";
            #binding-cells = <0>;
            bindings = <&kp RU_CYRILLIC_IE>, <&kp RU_CYRILLIC_IO>;
        };

        E_HE: E_HE {
            compatible = "zmk,behavior-tap-dance";
            label = "E_HE";
            #binding-cells = <0>;
            bindings = <&kp RU_CYRILLIC_E>, <&kp RU_CYRILLIC_HA>;
        };

        grave_codeblock: grave_codeblock {
            compatible = "zmk,behavior-tap-dance";
            label = "GRAVE_CODEBLOCK";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&triple_grave>, <&code_block>;
        };

        shift_to_ru_layer: shift_to_ru_layer {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_TO_RU_LAYER";
            bindings = <&kp LEFT_SHIFT>, <&to_ru_layer>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        shift_to_en_layer: shift_to_en_layer {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_TO_EN_LAYER";
            bindings = <&kp LEFT_SHIFT>, <&to_en_layer>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESCAPE          &kp Q  &kp W  &kp E      &kp R     &kp T           &kp Y        &kp U        &kp I  &kp O  &kp P  &kp ENTER
&kp TAB             &kp A  &kp S  &kp D      &kp F     &kp G           &kp H        &kp J        &kp K  &kp L  &none  &kp BACKSPACE
&shift_to_ru_layer  &kp Z  &kp X  &kp C      &kp V     &kp B           &kp N        &kp M        &none  &none  &none  &none
                                  &kp LCTRL  &kp LGUI  &kp LEFT_ALT    &lt 4 SPACE  &lt 2 SPACE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        rus {
            bindings = <
&kp ESCAPE          &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &ye_yo                &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &sha_scha           &kp RU_CYRILLIC_ZE  &myagkiy_tverdiy     &kp ENTER
&kp TAB             &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL  &kp RU_CYRILLIC_DE  &kp RU_CYRILLIC_ZHE  &kp BACKSPACE
&shift_to_en_layer  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I     &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE  &kp RU_CYRILLIC_YU  &kp RU_CYRILLIC_E    &kp RU_CYRILLIC_HA
                                                                   &kp LCTRL           &kp LGUI            &kp LEFT_ALT          &lt 4 SPACE         &lt 3 SPACE
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        num_en {
            bindings = <
&kp NUBS       &kp PIPE   &kp AT_SIGN  &kp LEFT_BRACE    &kp RIGHT_BRACE        &grave_codeblock    &kp PLUS   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK  &kp ENTER
&kp HASH       &kp SQT    &kp SEMI     &kp LPAR          &kp RIGHT_PARENTHESIS  &kp PRCNT           &kp MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH     &kp BACKSPACE
&kp AMPERSAND  &kp CARET  &kp UNDER    &kp LEFT_BRACKET  &kp RIGHT_BRACKET      &kp QMARK           &kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA     &kp DOT
                                       &kp LEFT_SHIFT    &kp LEFT_ALT           &kp EXCL            &kp SPACE  &kp NUMBER_0
            >;
        };

        num_ru {
            bindings = <
&kp RU_BACKSLASH  &en PIPE        &en AT_SIGN       &en LEFT_BRACE           &en RIGHT_BRACE    &grave_codeblock      &kp RU_PLUS   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK  &kp ENTER
&en HASH          &en APOSTROPHE  &kp RU_SEMICOLON  &kp RU_LEFT_PARENTHESIS  &kp RU_RPAR        &kp RU_PERCENT        &kp RU_MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp RU_SLASH  &kp BACKSPACE
&en AMPERSAND     &en CARET       &kp UNDER         &en LEFT_BRACKET         &en RIGHT_BRACKET  &kp RU_QUESTION       &kp RU_EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp RU_COMMA  &kp RU_DOT
                                                    &kp LEFT_SHIFT           &kp LEFT_ALT       &kp RU_EXCLAMATION    &kp RU_SPACE  &kp NUMBER_0
            >;
        };

        nav {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4     &kp F5    &kp F6      &kp F7  &kp F8            &kp F9    &kp F10     &kp F11  &kp F12
&trans  &trans  &trans  &trans     &trans    &trans      &trans  &kp K_PLAY_PAUSE  &kp UP    &kp K_MUTE  &trans   &trans
&trans  &trans  &trans  &trans     &trans    &trans      &trans  &kp LEFT          &kp DOWN  &kp RIGHT   &trans   &trans
                        &kp LCTRL  &kp LGUI  &kp LALT    &none   &none
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };

        snipe {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
